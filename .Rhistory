tax_table(taxon))
ps # 1321 taxa and 34 samples
set.seed(21)
tissue3.da <- differentialTest(formula = ~ Percent_tissue_loss_1month,
phi.formula = ~ Percent_tissue_loss_1month,
formula_null = ~ 1,
phi.formula_null = ~ Percent_tissue_loss_1month,
test = "LRT", boot = FALSE, # LRT is for comparing 3 or more groups of samples
data = ps,
fdr_cutoff = 0.05)
length(tissue3.da$significant_taxa)
sigtaxto_df <- function(tissue3.da, ps) {
df.out <- c()
for (i in 1:length(tissue3.da$significant_models)) { #from 1 to the number of significant taxa
df.out = rbind(df.out, tissue3.da$significant_models[[i]]$coefficients[2, 1:4]) #bind the significant taxa with coefficient, std. error, t value, Pr. coefficients[2,] is the DA model output.
}
asv = as.vector(tissue3.da$significant_taxa) #get significant ASVs
Class = as.vector(otu_to_taxonomy(data = ps, tissue3.da$significant_taxa, level = c("Class")))
Order = as.vector(otu_to_taxonomy(data = ps, tissue3.da$significant_taxa, level = c("Order")))
Family = as.vector(otu_to_taxonomy(data = ps, tissue3.da$significant_taxa, level = c("Family")))
Genus = as.vector(otu_to_taxonomy(data = ps, tissue3.da$significant_taxa, level = c("Genus")))
Sequence = as.vector(otu_to_taxonomy(data = ps, tissue3.da$significant_taxa, level = c("Sequence")))
df.bind <- as.data.frame(cbind(df.out, asv, Class, Order, Family, Genus, Sequence))
df.bind$asvgenus <- paste0(df.bind$Genus, " (", df.bind$asv, ")")
colnames(df.bind) <- c("Estimate", "StdError", "tvalue", "Pr", "asv", "Class", "Order", "Family", "Genus","Sequence","GenusASV")
df.bind$Estimate = as.numeric(as.character(df.bind$Estimate)) #estimate column should be numeric
df.bind$StdError = as.numeric(as.character(df.bind$StdError)) #stderror column should be numeric
return(df.bind)
}
df <- sigtaxto_df(tissue3.da, ps)
View(df)
### Save these data so you don't have to re-run the model ###
write.table(df, "DA_ASV_tissue-loss.txt", sep="\t",row.names = FALSE)
