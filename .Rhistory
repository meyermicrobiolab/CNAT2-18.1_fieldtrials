df.bind <- as.data.frame(cbind(df.out, asv, Class, Order, Family, Genus, Sequence))
df.bind$asvgenus <- paste0(df.bind$Genus, " (", df.bind$asv, ")")
colnames(df.bind) <- c("Estimate", "StdError", "tvalue", "Pr", "asv", "Class", "Order", "Family", "Genus","Sequence","asvtaxa")
df.bind$Estimate = as.numeric(as.character(df.bind$Estimate)) #estimate column should be numeric
df.bind$StdError = as.numeric(as.character(df.bind$StdError)) #stderror column should be numeric
return(df.bind)
}
df <- sigtaxto_df(tissue1.da, ps)
otu <- read.table("silva_nochloronomito_otu_table_corncob.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_nochloronomito_taxa_table_corncob.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
ps <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
ps # 1321 taxa and 34 samples
###################### What taxa are differentially abundant between Apparently Healthy and Disease Lesion samples?
# DA determined relative to first reference level, so set this manually to the "none" treatment
sample_data(ps)$Health<-factor(sample_data(ps)$Health,levels=c("Apparently Healthy","Disease Lesion"))
set.seed(1)
tissue1.da <- differentialTest(formula = ~ Health,
phi.formula = ~ Health,
formula_null = ~ 1,
phi.formula_null = ~ Health,
test = "Wald", boot = FALSE, # Wald is for comparing 2 groups of samples
data = ps,
fdr_cutoff = 0.05)
# examine the results of the analysis
summary(tissue1.da)
tissue1.da
length(tissue1.da$significant_taxa) # n = 1
tissue1.da$significant_taxa
# ASV12
otu_to_taxonomy(OTU = tissue1.da$significant_taxa, data = ps) # look at taxonomy of significant taxa
# "Bacteria_Pseudomonadota_Alphaproteobacteria_Rhodobacterales_Paracoccaceae_Shimia"
plot(tissue1.da, c("Genus"))
# Positive values mean that taxon is enriched in Disease Lesion relative to Apparently Healthy tissue
tissue1.da$p["ASV12"]
# p = 7.3716e-05
tissue1.da$p_fdr["ASV12"]
# p_fdr = 0.01732326
# create a function that will return the values of interest
sigtaxto_df <- function(tissue1.da, ps) {
df.out <- c()
for (i in 1:length(tissue1.da$significant_models)) { #from 1 to the number of significant taxa
df.out = rbind(df.out, tissue1.da$significant_models[[i]]$coefficients[2, 1:4]) #bind the significant taxa with coefficient, std. error, t value, Pr. coefficients[2,] is the DA model output.
}
asv = as.vector(tissue1.da$significant_taxa) #get significant ASVs
Class = as.vector(otu_to_taxonomy(data = ps, tissue1.da$significant_taxa, level = c("Class")))
Order = as.vector(otu_to_taxonomy(data = ps, tissue1.da$significant_taxa, level = c("Order")))
Family = as.vector(otu_to_taxonomy(data = ps, tissue1.da$significant_taxa, level = c("Family")))
Genus = as.vector(otu_to_taxonomy(data = ps, tissue1.da$significant_taxa, level = c("Genus")))
Sequence = as.vector(otu_to_taxonomy(data = ps, tissue1.da$significant_taxa, level = c("Sequence")))
df.bind <- as.data.frame(cbind(df.out, asv, Class, Order, Family, Genus, Sequence))
df.bind$asvgenus <- paste0(df.bind$Genus, " (", df.bind$asv, ")")
colnames(df.bind) <- c("Estimate", "StdError", "tvalue", "Pr", "asv", "Class", "Order", "Family", "Genus","Sequence","asvtaxa")
df.bind$Estimate = as.numeric(as.character(df.bind$Estimate)) #estimate column should be numeric
df.bind$StdError = as.numeric(as.character(df.bind$StdError)) #stderror column should be numeric
return(df.bind)
}
df <- sigtaxto_df(tissue1.da, ps)
View(df)
View(df)
