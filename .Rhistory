Family = as.vector(otu_to_taxonomy(data = ps, tissue3.da$significant_taxa, level = c("Family")))
df.bind <- as.data.frame(cbind(df.out, asv, Class, Order, Family))
colnames(df.bind) <- c("Estimate", "StdError", "tvalue", "Pr", "asv", "Class", "Order", "Family")
df.bind$Estimate = as.numeric(as.character(df.bind$Estimate)) #estimate column should be numeric
df.bind$StdError = as.numeric(as.character(df.bind$StdError)) #stderror column should be numeric
return(df.bind)
}
df <- sigtaxto_df(tissue3.da, ps_fam)
### Save these data so you don't have to re-run the model ###
write.table(df, "DA_Families_tissue-loss.txt", sep="\t",row.names = FALSE)
p1 <- ggplot(DAplot, aes(x=Percent_tissue_loss_1month, y=ProportionASV1,color=Health))+
geom_point(size=3)+
scale_color_manual(values=cols,breaks = c("Unaffected Tissue","Disease Lesion"))+
geom_smooth(method=lm,se=TRUE)+
ylab("Proportion of *Vibrio* ASV1")+
xlab("Percentage of Tissue Loss")+
theme_bw()+
theme(axis.text.x=element_text(size=14))+
theme(legend.position="right")+
theme(legend.title = element_text(size=14,face="bold"))+
theme(legend.text = element_text(size=14))
