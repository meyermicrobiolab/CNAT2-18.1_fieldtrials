Genus = as.vector(otu_to_taxonomy(data = ps, tissue2.da$significant_taxa, level = c("Genus")))
Sequence = as.vector(otu_to_taxonomy(data = ps, tissue2.da$significant_taxa, level = c("Sequence")))
df.bind <- as.data.frame(cbind(df.out, asv, Class, Order, Family, Genus, Sequence))
df.bind$asvgenus <- paste0(df.bind$Genus, " (", df.bind$asv, ")")
colnames(df.bind) <- c("Estimate", "StdError", "tvalue", "Pr", "asv", "Class", "Order", "Family", "Genus","Sequence","asvtaxa")
df.bind$Estimate = as.numeric(as.character(df.bind$Estimate)) #estimate column should be numeric
df.bind$StdError = as.numeric(as.character(df.bind$StdError)) #stderror column should be numeric
return(df.bind)
}
