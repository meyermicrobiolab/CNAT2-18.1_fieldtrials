# Add ASVs to the taxonomy table and save the significant asvs
tax_table(ps)[,7] <- rownames(tax_table(ps)) # 6 phylogenetic ranks in Silva v. 138.2 + ASV sequence column that I added = 7 ranks
sig.taxonomy <- as.data.frame(tax_table(ps)[tissue2.da$significant_taxa,])
tissue2.da.models.df <- ldply(tissue2.da.models, data.frame) %>%
left_join(sig.taxonomy, by = c(".id" = "sequence")) %>%
mutate(family_asv = paste0(Genus, "_(", .id,")"))
