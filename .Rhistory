library(stringr)
library(cowplot)
writeLines(capture.output(sessionInfo()), "sessionInfo.txt")
############# PLOT: 1) Vibrio ASV1 versus tissue loss
# Create phyloseq object with relative abundance of filtered ASVs (low abundance taxa removed)
otu <- read.table("silva_nochloronomito_otu_table_ps1_RA.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_nochloronomito_taxa_table_ps1.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
ps_ra <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
ps_ra # 312 taxa and 34 samples
otu_da = as(otu_table(ps_ra), "matrix")
taxon_da = as(tax_table(ps_ra), "matrix")
da<-t(otu_da)
da <- as.data.frame(da)
da <- tibble::rownames_to_column(da, "ASV")
taxon_da <- as.data.frame(taxon_da)
taxon_da <- tibble::rownames_to_column(taxon_da, "ASV")
taxon_da$Species<-NULL
da_tax <- merge(taxon_da, da, by="ASV", all=FALSE)
###Pull out ASV of interest
DA1 <- da_tax %>% filter(ASV == "TACGGAGGGTGCGAGCGTTAATCGGAATTACTGGGCGTAAAGCGCATGCAGGTGGTTTGTTAAGTCAGATGTGAAAGCCCGGGGCTCAACCTCGGAATAGCATTTGAAACTGGCAGACTAGAGTACTGTAGAGGGGGGTAGAATTTCAGGTGTAGCGGTGAAATGCGTAGAGATCTGAAGGAATACCGGTGGCGAAGGCGGCCCCCTGGACAGATACTGACACTCAGATGCGAAAGCGTGGGGAGCAAACAGG") #sequence for ASV1 Vibrio
DA_long<-melt(DA1,value.name="proportion",variable.name="sample")
DA_long$ASV<-NULL
DA_long$Kingdom<-NULL
DA_long$Phylum<-NULL
DA_long$Class<-NULL
DA_long$Order<-NULL
DA_long$Family<-NULL
DA_long$Genus<-NULL
colnames(DA_long)[2] <- "ProportionASV1"
# Merge with metadata for plotting aesthetics
samples <- as.data.frame(samples)
samples <- tibble::rownames_to_column(samples, "sample")
DAplot <- merge(samples,DA_long,by="sample", all=TRUE)
# reduce decimal places in proporation column
DAplot$ProportionASV1<-round(DAplot$ProportionASV1,3)
#set aesthetics
#theme_set(theme_bw()+theme(panel.grid.major = element_blank(),panel.grid.minor = element_blank()))
cols<-c("Unaffected Tissue"="#0072B2","Disease Lesion"="#D55E00")
pdf("VibrioASV1_vs_TissueLoss.pdf",bg ="white",width=8)
p1 <- ggplot(DAplot, aes(x=Percent_tissue_loss_1month, y=ProportionASV1,color=Health))+
geom_point(size=3)+
scale_color_manual(values=cols,breaks = c("Disease Lesion","Unaffected Tissue"))+
geom_smooth(method=lm,se=TRUE)+
ylab(expression("Proportion of"~italic(Vibrio)~"ASV1"))+
xlab("Percentage of Tissue Loss")+
theme_bw()+
theme(axis.title = element_text(size=14))+
theme(axis.text.x=element_text(size=14))+
theme(legend.position="right")+
theme(legend.title = element_text(size=14,face="bold"))+
theme(legend.text = element_text(size=14))
p1
dev.off()
