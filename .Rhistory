print(perm4)
perm5<-pairwise.adonis2(dist.clr~Health/Tag.ID,as(sample_data(ps1),"data.frame"), strata='Tag.ID')
print(perm5) # copy output to text file
perm4<-pairwise.adonis2(dist.clr~Treatment/Tag.ID,as(sample_data(ps1),"data.frame"), strata='Tag.ID')
print(perm4) # copy output to text file
perm5<-pairwise.adonis2(dist.clr~Health/Tag.ID,as(sample_data(ps1),"data.frame"), strata='Tag.ID')
