knitr::opts_chunk$set(echo = TRUE)
otu <- read.table("silva_otu_table.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_taxa_table.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
library(dada2)
library(CoDaSeq)
library(ggplot2)
library(phyloseq)
library(vegan)
library(pairwiseAdonis)
library(corncob)
library(knitr)
library(dplyr)
library(tibble)
library(reshape2)
library(cowplot)
writeLines(capture.output(sessionInfo()), "sessionInfo.txt")
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
ps <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
ps
get_taxa_unique(ps, "Family")
get_taxa_unique(ps, "Order")
get_taxa_unique(ps, "Kingdom")
ps <- subset_taxa(ps, Family !="Mitochondria")
ps <- subset_taxa(ps, Order !="Chloroplast")
ps <- subset_taxa(ps, Kingdom !="Eukaryota")
ps <- subset_taxa(ps, Kingdom !="NA")
get_taxa_unique(ps, "Family")
get_taxa_unique(ps, "Order")
get_taxa_unique(ps, "Kingdom")
ps
# 1984 taxa and 58 samples
length(get_taxa_unique(ps, "Genus")) # 529 genera
length(get_taxa_unique(ps, "Family")) # 284 families
length(get_taxa_unique(ps, "Order")) # 175 orders
length(get_taxa_unique(ps, "Class")) # 78 classes
length(get_taxa_unique(ps, "Phylum")) # 36 phyla
