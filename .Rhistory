otu <- read.table("silva_nochloronomito_otu_table_corncob.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_nochloronomito_taxa_table_corncob.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
ps <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
ps # 1321 taxa and 34 samples
# collapse ASVs into higher taxonomic groups for DA analysis
ps_fam <- ps %>% phyloseq::tax_glom("Family")
ps_fam #232 families and 34 samples
sample_data(ps_fam)$Health<-factor(sample_data(ps_fam)$Health,levels=c("Unaffected Tissue","Disease Lesion")) # positive values = enriched in disease lesion relative to unaffected tissue; negative values = depleted in disease lesion relative to unaffected tissue
set.seed(1)
tissue1.da <- differentialTest(formula = ~ Health,
phi.formula = ~ Health,
formula_null = ~ 1,
phi.formula_null = ~ Health,
test = "Wald", boot = FALSE, # Wald is for comparing 2 groups of samples
data = ps_fam,
fdr_cutoff = 0.05)
tissue1.da$p["ASV10","ASV15","ASV23","ASV35"]
tissue1.da$p[c("ASV10","ASV15","ASV23","ASV35")]
tissue1.da$p_fdr[c("ASV10","ASV15","ASV23","ASV35")]
#                                                                            ASV10
#       "Bacteria_Pseudomonadota_Alphaproteobacteria_Rhodobacterales_Paracoccaceae"
#                                                                            ASV15
#     "Bacteria_Campylobacterota_Campylobacteria_Campylobacterales_Arcobacteraceae"
#                                                                            ASV23
#                      "Bacteria_Bacillota_Clostridia_Clostridiales_Clostridiaceae"
#                                                                            ASV35
# "Bacteria_Pseudomonadota_Gammaproteobacteria_Pseudomonadales_Saccharospirillaceae"
# this makes sense looking at the relative abundance of families in disease lesion versus unaffected tissue
plot(tissue1.da, c("Family"))
