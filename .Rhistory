ps # 1321 taxa and 34 samples
set.seed(11)
tissue2.da <- differentialTest(formula = ~ Percent_healthy_remaining_1month,
phi.formula = ~ Percent_healthy_remaining_1month,
formula_null = ~ 1,
phi.formula_null = ~ Percent_healthy_remaining_1month,
test = "LRT", boot = FALSE, # LRT is for comparing 3 or more groups of samples
data = ps,
fdr_cutoff = 0.05)
length(tissue2.da$significant_taxa) # n = 28 differentially abundant taxa out of 1321
# examine the results of the analysis
summary(tissue2.da)
tissue2.da
tissue2.da$$discriminant_taxa_DA
tissue2.da$discriminant_taxa_DA
length(tissue2.da$discriminant_taxa_DA) #327
tissue2.da$p_fdr[c("ASV329","ASV374","ASV395","ASV438","ASV498","ASV821","ASV992","ASV993","ASV994","ASV995","ASV996","ASV997","ASV998","ASV1151","ASV1152","ASV1167","ASV1259","ASV1260","ASV1261","ASV1262","ASV1263","ASV1264","ASV1265","ASV1266","ASV1267","ASV1268","ASV1294","ASV1295")] # look at the FDR-adjusted p-values for each ASV
