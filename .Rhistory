sigtaxto_df <- function(tissue2.da, ps) {
df.out <- c()
for (i in 1:length(tissue2.da$significant_models)) { #from 1 to the number of significant taxa
df.out = rbind(df.out, tissue2.da$significant_models[[i]]$coefficients[2, 1:4]) #bind the significant taxa with coefficient, std. error, t value, Pr. coefficients[2,] is the DA model output.
}
asv = as.vector(tissue2.da$significant_taxa) #get significant ASVs
Class = as.vector(otu_to_taxonomy(data = ps5_BS2, tissue2.da$significant_taxa, level = c("Class")))
Order = as.vector(otu_to_taxonomy(data = ps5_BS2, tissue2.da$significant_taxa, level = c("Order")))
Family = as.vector(otu_to_taxonomy(data = ps5_BS2, tissue2.da$significant_taxa, level = c("Family")))
Genus = as.vector(otu_to_taxonomy(data = ps5_BS2, tissue2.da$significant_taxa, level = c("Genus")))
Sequence = as.vector(otu_to_taxonomy(data = ps5_BS2, tissue2.da$significant_taxa, level = c("Sequence")))
df.bind <- as.data.frame(cbind(df.out, asv, Class, Order, Family, Genus, Sequence))
df.bind$asvgenus <- paste0(df.bind$Genus, " (", df.bind$asv, ")")
colnames(df.bind) <- c("Estimate", "StdError", "tvalue", "Pr", "asv", "Class", "Order", "Family", "Genus","Sequence","asvtaxa")
df.bind$Estimate = as.numeric(as.character(df.bind$Estimate)) #estimate column should be numeric
df.bind$StdError = as.numeric(as.character(df.bind$StdError)) #stderror column should be numeric
return(df.bind)
}
sigtaxto_df <- function(tissue2.da, ps) {
df.out <- c()
for (i in 1:length(tissue2.da$significant_models)) { #from 1 to the number of significant taxa
df.out = rbind(df.out, tissue2.da$significant_models[[i]]$coefficients[2, 1:4]) #bind the significant taxa with coefficient, std. error, t value, Pr. coefficients[2,] is the DA model output.
}
asv = as.vector(tissue2.da$significant_taxa) #get significant ASVs
Class = as.vector(otu_to_taxonomy(data = ps, tissue2.da$significant_taxa, level = c("Class")))
Order = as.vector(otu_to_taxonomy(data = ps, tissue2.da$significant_taxa, level = c("Order")))
