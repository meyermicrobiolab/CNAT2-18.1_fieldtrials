otu <- read.table("silva_nochloronomito_otu_table_ps1_RA.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_nochloronomito_taxa_table_ps1.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
ps_ra <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
ps_ra
get_taxa_unique(ps_ra, "Genus") #  genera
get_taxa_unique(ps_ra, "Family") #  families
get_taxa_unique(ps_ra, "Order") #  orders
ps_ra_f = tax_glom(ps_ra, "Family")
ps_ra_f #   families
otu_f = as(otu_table(ps_ra_f), "matrix")
taxon_f = as(tax_table(ps_ra_f), "matrix")
fam<-t(otu_f)
fam <- as.data.frame(fam)
fam <- tibble::rownames_to_column(fam, "ASV")
taxon_f <- as.data.frame(taxon_f)
taxon_f <- tibble::rownames_to_column(taxon_f, "ASV")
fam_tax <- merge(taxon_f, fam, by="ASV", all=FALSE)
fam_tax$Genus<-NULL
fam_tax$ASV<-NULL
# Order by total relative abundance and choose top 25 families
fam_tax <- fam_tax %>% mutate("total" = rowSums((fam_tax[,6:63]), na.rm = TRUE))
View(fam_tax)
# Order by total relative abundance and choose top 25 families
fam_tax <- fam_tax %>% mutate("total" = rowSums((fam_tax[,6:39]), na.rm = TRUE))
View(fam_tax)
fam_tax <- fam_tax[order(fam_tax$total, decreasing = TRUE),]
fam25 <- fam_tax[1:25,]
fam25$total<-NULL
fam_long<-melt(fam25,value.name="proportion",variable.name="sample",id.vars=c("Kingdom","Phylum","Class","Order","Family"))
# Merge with metadata for plotting aesthetics
samples <- as.data.frame(samples)
samples <- tibble::rownames_to_column(samples, "sample")
famplot <- merge(fam_long,samples,by="sample", all=TRUE)
#
# how many classes or orders in the top 25 families?
unique(famplot$Class) # 9 classes:"Gammaproteobacteria","Alphaproteobacteria","Bacteroidia","Campylobacteria","Cyanobacteriia","Verrucomicrobiia","Clostridia","Blastocatellia","Acidimicrobiia"
"Gammaproteobacteria","Alphaproteobacteria","Bacteroidia","Campylobacteria","Cyanobacteriia","Verrucomicrobiia","Clostridia","Blastocatellia","Acidimicrobiia"
unique(famplot$Family)
View(famplot)
View(fam25)
# write out this table to sort the families by taxonomy (alphabetical by phylum, then class, then order, then family)
write.table(fam25,"top25families.txt",sep="\t",col.names=NA)
theme_set(theme_bw()+theme(panel.grid.major = element_blank(),panel.grid.minor = element_blank()))
cbPalette <- c("#999999", "#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#CC79A7","#000000")
# order families alphabetically under class, first = bottom of plot
famplot$Family<-factor(famplot$Family, levels=c("Rubritaleaceae","Sandaracinaceae","Saccharospirillaceae","Nitrincolaceae","Ga0077536","Vibrionaceae","Shewanellaceae","Pseudoalteromonadaceae","Moritellaceae","Colwelliaceae","Alteromonadaceae","Alcaligenaceae","Desulfovibrionaceae","Cyanobiaceae","Clostridiaceae","Arcobacteraceae","Blastocatellaceae","Flavobacteriaceae","Cyclobacteriaceae","Rhodospirillales","AEGEAN-169 marine group","Paracoccaceae","SAR116 clade","Clade I","Rhizobiaceae"))
bubble <- ggplot(famplot, aes(x=sample,y=Family,size=proportion,color=Class))+
geom_point(alpha=0.8)+
scale_size(range = c(0,10), name="Relative abundance")+
scale_color_manual(values=cbPalette)+
facet_grid(Health ~ Month, scales="free", space="free")+
theme(axis.text.x=element_blank())+
theme(axis.text.y=element_text(size=10))+
theme(axis.title.x=element_blank())+
theme(axis.title.y=element_blank())+
theme(legend.text = element_text(size=10))
bubble
